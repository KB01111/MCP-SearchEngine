# MCP SearchEngine — optional environment configuration.
# Copy to `.env` (or export in your shell / service manager) as needed.
# All values are optional; the server runs fine without any of these.

# --- Perplexity (opt-in search source, NOT in defaults) -------------------
# Needed only if you want the ``perplexity`` source. Get a key at
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- Proxy (privacy) --------------------------------------------------------
# Route outbound requests through a proxy. Higher precedence than HTTPS_PROXY
# / ALL_PROXY. http://, socks5:// and socks5h:// schemes are supported.
# The `h` in socks5h means DNS is resolved at the proxy (no local DNS leak).
# Uncomment for a local Tor SOCKS proxy:
# SEARCH_PROXY_URL=socks5h://127.0.0.1:9050
# (A plain OS-level VPN already routes everything through it; this is orthogonal.)

# --- X/Twitter nitter instance ---------------------------------------------
# Optional nitter instance tried FIRST (before the built-in defaults) for the
# ``x`` source. Set to any nitter mirror. Leave empty to use built-in defaults.
X_NITTER_INSTANCE=

# --- External sandbox relay (privacy) ---------------------------------------
# If set, treated as a relay prefix: every page fetch is rewritten to
# {SEARCH_SANDBOX_URL}<url-encoded target> and performed by an external
# disposable sandbox (e.g. a self-hosted agentOS/Rivet VM relay,
# https://agentos-sdk.dev/docs/apps/), so the local machine never touches the
# target site.
# SEARCH_SANDBOX_URL=https://sandbox.example.com/fetch?url=